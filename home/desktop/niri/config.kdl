//----------//
// MONITORS //
//----------//

// MAIN MONITOR
  output "DP-1" {
    mode "2560x1440@179.999"
    scale 1
    transform "normal"
    position x=0 y=0
  }

// EXTRA MONITOR
  output "HDMI-A-1" {
    mode "1280x1024@75.025"
    scale 1
    transform "normal"
    position x=0 y=418
    layout {
      default-column-width {
        proportion 1.0
      }
    }
  }

//--------------------//
// KEYBOARD AMD MOUSE //
//--------------------//
  input {

  // KEYBORAD LAYOUT CHANGE VIA CAPS LOCK
    keyboard {
      xkb {
        layout "us,ru"
        options "grp:caps_toggle"
      }
    }

  // MOUSE OPTIONS
    mouse {
      // off
      // natural-scroll
      // accel-speed 0.2
      // accel-profile "flat"
      // scroll-method "no-scroll"
    }
  // EXTRA MOUSE OPTION
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
  }

//--------//
// CURSOR //
//--------//
  cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24

    hide-when-typing
    hide-after-inactive-ms 2500
  }

//----------------//
// LAYOUT WINDOWS //
//----------------//
  layout {
    gaps 16
    background-color "transparent"
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        off
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        // off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        // on
        // draw-behind-window true
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
  }

//-------//
// OTHER //
//-------//

// AUTOSTART
  spawn-at-startup "noctalia"

// HIDE HOTKEY OVERLAY
  hotkey-overlay {
    skip-at-startup
  }

// DISABLE HOT CORNERS
  gestures {
    hot-corners {
        off
    }
  }

// HIDE WINDOW FRAME
  prefer-no-csd

// SCREENSHOT PATH
  screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

//------------//
// ANIMATIONS //
//------------//
  animations {
    // off
    // slowdown 3.0
  }

//--------------//
// WINDOW RULES //
//--------------//
  window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
  }

  window-rule {
    match app-id=r#"^com\.danklinux\.dms$"#
    open-floating true
  }

  layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
  }

  window-rule {
    match app-id="Alacriity"
    match app-id="Kitty"
    draw-border-with-background false
  }

//---------------//
// IMORT CONFIGS //
//---------------//
include "binds.kdl"
include "noctalia.kdl"
